; PICA200 vertex shader for the native Excitebike scene renderer.
; One projected, textured quad corner per vertex; colour comes from the tile atlas.

; Uniforms
.fvec projMtx[4]

; Constants
.constf common_const(0.0, 1.0, 0.0, 0.0)
.alias  ones common_const.yyyy

; Outputs
.out oPosition position
.out oTexCoord texcoord0
.out oColor    color

; Inputs
.in iPosition v0
.in iTexCoord v1

.entry scene_main
.proc scene_main
	; r0 = vec4(iPosition, 1.0)
	mov r0.xyz, iPosition
	mov r0.w,   ones

	; oPosition = projMtx * r0
	dp4 oPosition.x, projMtx[0], r0
	dp4 oPosition.y, projMtx[1], r0
	dp4 oPosition.z, projMtx[2], r0
	dp4 oPosition.w, projMtx[3], r0

	mov oTexCoord, iTexCoord
	mov oColor,    ones

	end
.end
